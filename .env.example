# The bot token from the developer portal (Authorization: Bot <token>).
DUVET_BOT_TOKEN=

# How many gateway shards to open: 1 is plenty for one bot, up to 64.
DUVET_SHARDS=1

# Resume a dropped gateway session instead of starting a new one.
DUVET_RESUME=true

# The API and gateway. Change these for a local stack.
DUVET_API=api.duvet.chat
DUVET_WS=ws.duvet.chat
DUVET_SECURE=true

# How long a request may make no progress.
DUVET_TIMEOUT_MS=20000
